# Copy to .env on the deployment host. Never commit .env.
# Generate API_KEY: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=
# Public DNS name pointing to the host; Caddy obtains HTTPS certificates.
# For a local Docker test only: SITE_ADDRESS=http://localhost
SITE_ADDRESS=vision.example.com
ANALYZER_CALLABLE=backend.cashwatch_adapter:analyze_video
ANALYSIS_TIMEOUT_SECONDS=270
ANALYSIS_WORKERS=1
ANALYSIS_QUEUE_CAPACITY=4
RESULT_RETENTION_SECONDS=86400
